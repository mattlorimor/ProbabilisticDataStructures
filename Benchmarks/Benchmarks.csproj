<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 only, until a stable BenchmarkDotNet supports .NET 11. 0.15.8 stops
         before running anything on .NET 11 ("GetRuntimeVersion not implemented for
         NotRecognized": its runtime list ends at .NET 10); 0.16.0-preview.2 adds it. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimized builds; guard against Debug runs. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProbabilisticDataStructures/ProbabilisticDataStructures.csproj" />
  </ItemGroup>

</Project>
